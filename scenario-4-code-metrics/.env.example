# Environment variables for Scenario 4 — Code Metrics Agent
# Copy to .env and fill in values, OR use .NET User Secrets (recommended for local dev):
#   dotnet user-secrets set AZURE_OPENAI_ENDPOINT <your-endpoint> --project src/code-metrics-agent/code-metrics-agent.csproj
#   dotnet user-secrets set AZURE_OPENAI_DEPLOYMENT_NAME <deployment-name> --project src/code-metrics-agent/code-metrics-agent.csproj

# Azure OpenAI endpoint (from setup.ps1 output)
AZURE_OPENAI_ENDPOINT=https://your-account.openai.azure.com/

# Model deployment name (default: gpt-5-mini)
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini

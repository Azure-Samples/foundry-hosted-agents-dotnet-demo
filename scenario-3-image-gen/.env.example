# Environment variables for Scenario 3 (Image Generator Agent)
# Copy to .env and fill in values, OR use .NET User Secrets (recommended for local dev):
#   dotnet user-secrets set AZURE_OPENAI_ENDPOINT <your-endpoint> --project src/HostedAgent/HostedAgent.csproj
#   dotnet user-secrets set AZURE_OPENAI_DEPLOYMENT_NAME <deployment-name> --project src/HostedAgent/HostedAgent.csproj
#   dotnet user-secrets set AZURE_AI_FOUNDRY_PROJECT_ENDPOINT <your-foundry-endpoint> --project src/HostedAgent/HostedAgent.csproj

# Azure OpenAI endpoint (from setup.ps1 output)
AZURE_OPENAI_ENDPOINT=https://your-account.openai.azure.com/

# Model deployment name (default: gpt-5-mini)
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini

# Microsoft Foundry project endpoint (required for FLUX.2 cloud generation)
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com
